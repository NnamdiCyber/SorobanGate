{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [] },
  "description": "SorobanGate RPC Gateway — operational dashboard",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sorobangate_requests_total[1m]))",
          "legendFormat": "req/s"
        }
      ]
    },
    {
      "id": 2,
      "title": "P50 Latency (ms)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(sorobangate_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P50 ms"
        }
      ]
    },
    {
      "id": 3,
      "title": "P99 Latency (ms)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(sorobangate_request_duration_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "P99 ms"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache Hit Rate",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(sorobangate_cache_hits_total[1m])) / (sum(rate(sorobangate_cache_hits_total[1m])) + sum(rate(sorobangate_cache_misses_total[1m])))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 5,
      "title": "Requests by Method",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (method) (rate(sorobangate_requests_total[1m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(sorobangate_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "5xx/s"
        }
      ]
    },
    {
      "id": 7,
      "title": "Upstream Health",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sorobangate_upstream_health",
          "legendFormat": "{{upstream}} ({{pool}})",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "title": "Circuit Breaker States",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sorobangate_circuit_breaker_state",
          "legendFormat": "{{upstream}}",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Rate Limit Rejections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 18 },
      "targets": [
        {
          "expr": "sum by (tier) (rate(sorobangate_rate_limit_rejections_total[1m]))",
          "legendFormat": "{{tier}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Active Connections",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "targets": [
        {
          "expr": "sum by (pool) (sorobangate_active_connections)",
          "legendFormat": "{{pool}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["sorobangate", "stellar", "soroban"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SorobanGate",
  "uid": "sorobangate-v1",
  "version": 1
}
